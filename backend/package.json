{
  "name": "siga-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do protótipo SIGA: bairros, ecopontos e guia de resíduos",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
  "start": "node src/server.js",
  "dev": "node --watch src/server.js",
  "seed": "node src/seed.js",
  "test": "node --test",
  "test:browser": "node scripts/browser-smoke.mjs",
  "test:all": "npm test && npm run test:browser"
  },
  "dependencies": {
    "cloudinary": "2.11.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
