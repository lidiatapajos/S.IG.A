# Copie para .env. A aplicação usa Node.js 24.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# 0 em acesso direto. Ajuste para a quantidade EXATA de proxies confiáveis.
# Render: normalmente 1; confirme o caminho de rede antes de mudar.
TRUST_PROXY_HOPS=0
PERSISTENT_STORAGE_CONFIRMED=false
# Caminho relativo à pasta backend. Em hospedagem, use um disco persistente.
DB_FILE=./data/siga.db
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Obrigatório em produção; libera o painel /admin. Nunca coloque no Flutter.
ADMIN_API_TOKEN=
# Origens extras do Flutter Web, separadas por vírgula, sem barra final.
# Em desenvolvimento localhost e 127.0.0.1 são aceitos em qualquer porta.
# Inclua também a origem HTTPS da PRÓPRIA API: o painel/rastreador enviam POST/PUT.
CORS_ORIGINS=http://localhost:8080

# Armazenamento externo de imagens (Cloudinary), OPCIONAL no MVP.
# Sem as três credenciais a API guarda a imagem privada como BLOB no SQLite.
# No Render, configure DB_FILE em disco persistente para não perder denúncias.
# Nunca coloque estas credenciais no Flutter.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
